# ============================================================
# 环境变量示例：复制为 backend/.env 后填入真实值。
# 后端已引入 springboot3-dotenv，启动时会自动读取 backend/.env。
# ============================================================

DB_PASSWORD=
AI_CONFIG_AES_KEY=
AMAP_WEB_SERVICE_KEY=

# 文本大模型（环境变量方式启用，LLM_BASE_URL / LLM_MODEL / DEEPSEEK_API_KEY 三项需同时配置）
# 示例使用 DeepSeek（OpenAI 兼容协议）：
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
