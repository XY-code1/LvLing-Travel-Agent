# ============================================================
# 生产部署环境变量示例（docker-compose 读取根目录 .env）
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略。
# ⛔ 不要提交真实值，不要写入前端或镜像。
# ============================================================

# MySQL root 密码（仅用于初始化和运维）
DB_ROOT_PASSWORD=
# 应用使用的 MySQL 账号密码（compose 会创建同名最小权限账号）
DB_PASSWORD=
DB_USERNAME=lvling

# 高德 Web Service Key（服务端）
AMAP_WEB_SERVICE_KEY=

# AI Provider 凭据解密密钥（≥32 位随机串）
AI_CONFIG_AES_KEY=

# 登录令牌密钥（≥32 位随机串）
JWT_SECRET=

# 允许跨域的前端来源（同源部署填正式域名）
CORS_ALLOWED_ORIGINS=https://example.com

# 管理后台找回密码恢复令牌；留空则关闭该接口
ADMIN_RESET_TOKEN=
